# Backend runtime configuration. Provide real values through the shell or a secret manager.
PLACEMENTOS_DB_URL=jdbc:mysql://localhost:3306/placementos?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
PLACEMENTOS_DB_USERNAME=your_mysql_username
PLACEMENTOS_DB_PASSWORD=your_mysql_password
PLACEMENTOS_JWT_SECRET=replace_with_a_private_random_secret_at_least_32_characters
PLACEMENTOS_JWT_EXPIRATION_MS=86400000
PLACEMENTOS_CORS_ALLOWED_ORIGINS=http://localhost:5173
PLACEMENTOS_UPLOAD_DIR=uploads
SERVER_PORT=8080
